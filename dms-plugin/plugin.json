{
    "id": "ariaDownloadManager",
    "name": "Aria Download Manager",
    "description": "Manage aria2c downloads from the bar - queue, automatic actions and live progress, backed by the Aria Download Manager daemon",
    "version": "1.3.0",
    "license": "MIT",
    "author": "FHADWA NUR'IZDHAD",
    "type": "composite",
    "capabilities": [
        "dankbar-widget",
        "control-center",
        "downloads"
    ],
    "components": {
        "widget": "./Aria2Widget.qml"
    },
    "component": "./Aria2Widget.qml",
    "settings": "./Aria2Settings.qml",
    "icon": "download",
    "requires_dms": ">=1.5.0",
    "dependencies": [
        "aria-download-manager"
    ],
    "permissions": [
        "settings_read",
        "settings_write",
        "process"
    ]
}
