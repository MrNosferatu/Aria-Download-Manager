[Unit]
Description=Aria Download Manager (background aria2c server for the extension and DMS widget)
Documentation=file:%h/GitHub/Aria2C/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/GitHub/Aria2C
ExecStart=/usr/bin/python3 -m aria_download_manager
# always, not on-failure: /api/restart exits cleanly to reload config
Restart=always
RestartSec=1
# aria2c is a child of the manager; kill the whole group on stop so no
# orphaned downloader survives.
KillMode=control-group
TimeoutStopSec=20

[Install]
WantedBy=default.target
