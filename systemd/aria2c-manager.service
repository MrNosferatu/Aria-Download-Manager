[Unit]
Description=aria2c manager (background aria2c server + web UI)
Documentation=file:%h/GitHub/Aria2C/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/GitHub/Aria2C
ExecStart=/usr/bin/python3 -m aria2c_manager
Restart=on-failure
RestartSec=3
# aria2c is a child of the manager; kill the whole group on stop so no
# orphaned downloader survives.
KillMode=control-group
TimeoutStopSec=20

[Install]
WantedBy=default.target
